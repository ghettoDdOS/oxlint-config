{
  "name": "@ghettoddos/oxlint-config",
  "version": "0.1.0",
  "description": "Oxlint config",
  "keywords": [
    "oxlint-config"
  ],
  "homepage": "https://github.com/ghettoDdOS/oxlint-config",
  "bugs": {
    "url": "https://github.com/ghettoDdOS/oxlint-config/issues"
  },
  "license": "MIT",
  "author": "ghettoDdOS <pen.egor2002@gmail.com> (https://github.com/ghettoDdOS/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghettoDdOS/oxlint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --clean --dts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "prepack": "nr build",
    "release": "bumpp",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-command": "4.0.0",
    "eslint-plugin-de-morgan": "2.1.3",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-regexp": "3.2.0",
    "oxlint-plugin-eslint": "1.79.0"
  },
  "devDependencies": {
    "@antfu/ni": "^30.5.0",
    "@oxlint/plugins": "1.79.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "bumpp": "^12.2.1",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    }
  }
}
